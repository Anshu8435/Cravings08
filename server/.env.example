# Server Environment Configuration
PORT=4500
NODE_ENV=production

# Database (MongoDB Atlas Connection URI)
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Cravings_DB?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP (for OTP Verification)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSCODE=your_google_app_password_16_characters

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_exampleKeyId
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend Allowed URLs (comma separated)
CLIENT_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
