{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/public/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/common/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/menu/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/restaurant/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/customer/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/rider/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/pools/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/payment/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/order/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/ping",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
